    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "mocha": "^12.0.2",
    "prettier": "^3.9.8",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.70.1",
